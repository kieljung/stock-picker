# Kopiere nach deploy.env und trage deine Werte ein. deploy.env ist gitignored.
#
# SSH_HOST     Ziel fuer ssh/rsync, also user@host oder ein Host-Alias aus
#              ~/.ssh/config. Der Zugang muss ohne Passwortabfrage
#              funktionieren (SSH-Key), sonst haengt das Skript.
# REMOTE_PATH  Absoluter Pfad des Document-Root auf dem Server. Nur
#              Buchstaben, Ziffern und . _ - / sind erlaubt -- der Pfad
#              landet in Remote-Kommandos.
# BASE_URL     Oeffentliche URL desselben Verzeichnisses, ohne Schraegstrich
#              am Ende. Damit prueft das Skript, ob der Schutz greift.
# PORTAL_USER  Benutzername fuer Basic Auth.
SSH_HOST=user@example.com
REMOTE_PATH=/home/user/htdocs
BASE_URL=https://picker.example.com
PORTAL_USER=picker
